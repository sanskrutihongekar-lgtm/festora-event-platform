# ==================== REQUIRED ====================
# Neon PostgreSQL connection string (from neon.tech dashboard)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Generate a long random string (e.g. openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Public URL of your deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# ==================== EMAIL (Resend) ====================
# Get from https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@yourdomain.com"
RESEND_FROM_NAME="FESTORA 2027"

# ==================== OPTIONAL ====================
# Unpooled connection (sometimes needed for migrations)
# DATABASE_URL_UNPOOLED="postgresql://..."

# Image storage (if using external provider later)
# IMAGE_STORAGE_PROVIDER="vercel-blob"
# IMAGE_STORAGE_API_KEY=""
# IMAGE_STORAGE_BASE_URL=""
